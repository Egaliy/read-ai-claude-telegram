# === Обязательные ключи ===

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram: создайте бота через @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш Telegram user id — единственный администратор бота (узнать: @userinfobot)
TELEGRAM_ADMIN_IDS=328826190

# Ваш chat id и/или id группы — получатели по умолчанию (добавляются при старте)
TELEGRAM_CHAT_ID=328826190
# TELEGRAM_CHAT_IDS=-1001234567890

# Доступ закрыт: новые пользователи не могут /start без команды /add от администратора

# === Read AI webhook ===

# Signing key из настроек webhook: app.read.ai/analytics/integrations/webhooks
# Если пусто — проверка подписи отключена (только для локальной отладки)
READAI_WEBHOOK_SIGNING_KEY=

# === Опционально ===

# Модель Claude
CLAUDE_MODEL=claude-sonnet-4-6

# Порт сервера
PORT=8000

# Путь к файлу с system-промптом
PROMPT_FILE=prompts/tasks_extraction.txt

# Фильтр по названию встречи (пусто = все встречи)
# Пример: MEETING_TITLE_FILTER=Проект Alpha
MEETING_TITLE_FILTER=

DATABASE_PATH=data/processed.db

# Redis Cloud (Vercel Integration)
REDIS_URL=

# Production only — ./scripts/run.sh локально не использовать (см. run.sh).
TELEGRAM_POLLING=false
TELEGRAM_WEBHOOK_URL=https://read-ai-claude-telegram.vercel.app/webhooks/telegram
# Read AI webhook URL (вставить в app.read.ai):
# https://read-ai-claude-telegram.vercel.app/webhooks/readai

# Постепенный набор текста (sendMessageDraft) в личных чатах
TELEGRAM_TYPEWRITER=true

# Для нативного чек-листа Telegram Business (опционально)
# TELEGRAM_BUSINESS_CONNECTION_ID=

# === Notion (бриф по кнопке «Получить бриф») ===
# Internal Integration: https://www.notion.so/my-integrations
# Создайте hub-страницу и дайте интеграции доступ (⋯ → Connections)
# NOTION_TOKEN=
# NOTION_PARENT_PAGE_ID=   # «no project» — сюда создаются страницы брифов
# NOTION_PROJECTS_DATABASE_ID=   # база Project Base — ссылка попадёт на страницу проекта
# NOTION_GENERAL_PAGE_ID=        # «no project», если проект не определён
# CRON_SECRET=                   # опционально; Vercel Cron шлёт Authorization: Bearer …
# scripts/notion_setup.py --under <page_id>
